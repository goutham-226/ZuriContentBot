# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Replicate API token (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=

# Local Postgres from docker-compose.yml (dev-only credentials)
DATABASE_URL=postgres://creator:creator_dev_password@127.0.0.1:5432/creatorfriendly

# API port (default 3001)
# PORT=3001

# Optional model overrides (defaults shown)
# TEXT_MODEL=qwen/qwen3-235b-a22b-instruct-2507
# IMAGE_MODEL=black-forest-labs/flux-schnell
# VOICE_MODEL=elevenlabs/v3
# VIDEO_MODEL=prunaai/p-video-2-pro-reference
# SFX_MODEL=zsxkib/mmaudio

# Reddit research is off by default. Set to "on" to use it (falls back to
# rate-limited RSS unless REDDIT_CLIENT_ID / REDDIT_CLIENT_SECRET are set,
# from a "script" app at https://www.reddit.com/prefs/apps)
# REDDIT_RESEARCH=off
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
